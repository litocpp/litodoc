{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/litocpp/litodoc/main/schema/publication-set.schema.json",
  "title": "litodoc publication set v1",
  "type": "object",
  "required": ["format", "version", "packages"],
  "properties": {
    "format": { "const": "litodoc-publication-set" },
    "version": { "const": 1 },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "version", "directory", "manifest"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string" },
          "directory": { "type": "string", "minLength": 1 },
          "manifest": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
