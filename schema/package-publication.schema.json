{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/litocpp/litodoc/main/schema/package-publication.schema.json",
  "title": "litodoc package publication v1",
  "type": "object",
  "required": ["format", "version", "package", "source", "generator", "entry", "files"],
  "properties": {
    "format": { "const": "litodoc-package-publication" },
    "version": { "const": 1 },
    "package": {
      "type": "object",
      "required": ["name", "version", "root_module"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "version": { "type": "string" },
        "root_module": { "type": "string" }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["identity"],
      "properties": {
        "identity": { "$ref": "#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    },
    "generator": {
      "type": "object",
      "required": [
        "litodoc",
        "frontend",
        "frontend_digest",
        "data_digest",
        "data_api",
        "template_api",
        "toolchain_version",
        "toolchain_target",
        "language_standard"
      ],
      "properties": {
        "litodoc": { "$ref": "#/$defs/nonEmptyString" },
        "frontend": { "$ref": "#/$defs/nonEmptyString" },
        "frontend_digest": { "$ref": "#/$defs/digest" },
        "data_digest": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
        "data_api": { "const": 3 },
        "template_api": { "const": 1 },
        "toolchain_version": { "$ref": "#/$defs/nonEmptyString" },
        "toolchain_target": { "$ref": "#/$defs/nonEmptyString" },
        "language_standard": { "$ref": "#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    },
    "entry": { "const": "index.html" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/file" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\).+$"
    },
    "file": {
      "type": "object",
      "required": ["path", "size", "sha256", "media_type", "cache"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "size": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/digest" },
        "media_type": { "$ref": "#/$defs/nonEmptyString" },
        "cache": { "const": "immutable" }
      },
      "additionalProperties": false
    }
  }
}
