{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/litocpp/litodoc/main/schema/site-manifest.schema.json",
  "title": "litodoc site manifest v1",
  "type": "object",
  "required": [
    "format",
    "version",
    "title",
    "output",
    "data_output",
    "data_only",
    "data_api",
    "template_api",
    "packages"
  ],
  "properties": {
    "format": { "const": "litodoc-site" },
    "version": { "const": 1 },
    "title": { "$ref": "#/$defs/nonEmptyString" },
    "output": { "$ref": "#/$defs/path" },
    "data_output": { "$ref": "#/$defs/path" },
    "frontend": {
      "oneOf": [
        { "$ref": "#/$defs/path" },
        { "type": "null" }
      ]
    },
    "data_only": { "type": "boolean" },
    "publication": {
      "enum": ["site", "package-set"],
      "default": "site"
    },
    "data_api": { "const": 3 },
    "template_api": { "const": 1 },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/package" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "response": {
      "type": "object",
      "required": ["path", "digest"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "package": {
      "type": "object",
      "required": [
        "name",
        "version",
        "root_module",
        "profile",
        "root",
        "toolchain_version",
        "toolchain_target",
        "language_standard",
        "responses"
      ],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "version": { "type": "string" },
        "source_identity": { "type": "string" },
        "root_module": { "type": "string" },
        "profile": { "$ref": "#/$defs/nonEmptyString" },
        "root": { "$ref": "#/$defs/path" },
        "toolchain_version": { "$ref": "#/$defs/nonEmptyString" },
        "toolchain_target": { "$ref": "#/$defs/nonEmptyString" },
        "language_standard": { "$ref": "#/$defs/nonEmptyString" },
        "responses": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/response" }
        }
      },
      "additionalProperties": false
    }
  }
}
