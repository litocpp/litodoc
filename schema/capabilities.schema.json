{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/litocpp/litodoc/main/schema/capabilities.schema.json",
  "title": "litodoc capabilities protocol v1",
  "type": "object",
  "required": [
    "format",
    "version",
    "extract_protocols",
    "site_manifest_versions",
    "data_api_versions",
    "litodoc_build",
    "clang_version",
    "clang_build"
  ],
  "properties": {
    "format": { "const": "litodoc-capabilities" },
    "version": { "const": 1 },
    "extract_protocols": { "$ref": "#/$defs/versions" },
    "site_manifest_versions": { "$ref": "#/$defs/versions" },
    "data_api_versions": { "$ref": "#/$defs/versions" },
    "litodoc_build": { "$ref": "#/$defs/nonEmptyString" },
    "clang_version": { "$ref": "#/$defs/nonEmptyString" },
    "clang_build": { "$ref": "#/$defs/nonEmptyString" }
  },
  "additionalProperties": false,
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "versions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    }
  }
}
